{
  "expo": {
    "name": "2uram",
    "slug": "2uram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uram",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.uram.app",
      "infoPlist": {
        "NSCameraUsageDescription": "한 시간마다 짧은 일상 영상을 찍기 위해 카메라를 사용해요",
        "NSMicrophoneUsageDescription": "영상에 소리를 함께 담기 위해 마이크를 사용해요"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CDC6BD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uram.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CDC6BD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "한 시간마다 짧은 일상 영상을 찍기 위해 카메라를 사용해요",
          "microphonePermission": "영상에 소리를 함께 담기 위해 마이크를 사용해요"
        }
      ],
      "expo-notifications",
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}